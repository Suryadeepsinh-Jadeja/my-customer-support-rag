# Copy to backend/.env for running the API outside Docker. Never commit .env.

APP_ENV=development

# PostgreSQL with pgvector (docker compose provides one on localhost:5432).
DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5432/travel
# Without Docker you can use SQLite for development (no vector search):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Signs access tokens. Required in production (32+ chars), e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60

# Cookies are Secure everywhere except development; override only if you must.
# COOKIE_SECURE=
# COOKIE_DOMAIN=

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=10

LOG_LEVEL=INFO
# json in production by default, text otherwise
# LOG_FORMAT=json

# Google Gemini (used from the assistant phase onwards)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
