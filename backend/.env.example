# Copy to backend/.env for running the API outside Docker. Never commit .env.

APP_ENV=development

# PostgreSQL with pgvector (docker compose provides one on localhost:5432).
DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5432/travel
# Without Docker you can use SQLite for development (no vector search):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Signs access tokens. Required in production (32+ chars), e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60

# Cookies are Secure everywhere except development; override only if you must.
# COOKIE_SECURE=
# COOKIE_DOMAIN=

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=10
# Shared rate limits across API processes (docker compose sets this). Empty = in-process.
# REDIS_URL=redis://localhost:6379/0
CHAT_RATE_LIMIT_PER_HOUR=200

LOG_LEVEL=INFO
# json in production by default, text otherwise
# LOG_FORMAT=json

# Google Gemini: document classification/extraction now, the assistant later.
# Without a key, documents are analysed by built-in rules (lower recall).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=60

# --- Booking providers -----------------------------------------------------------------
# Hotels, cars and excursions always use the built-in mock (test bookings). Flights use the
# mock too unless FLIGHT_PROVIDER=duffel; a duffel_test_ key gives Duffel's sandbox.
FLIGHT_PROVIDER=mock
DUFFEL_API_KEY=

# ---- Documents ----------------------------------------------------------------
# local: files under STORAGE_LOCAL_PATH (default backend/storage)
# s3:    any S3-compatible store (AWS S3, MinIO, Cloudflare R2, ...)
STORAGE_BACKEND=local
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_BUCKET=travel-documents

# Files are AES-256-GCM encrypted before storage. Required in production:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Keep it safe: losing it makes every stored file unreadable.
STORAGE_ENCRYPTION_KEY=

MAX_UPLOAD_MB=15
MAX_PDF_PAGES=50
MAX_DOCUMENTS_PER_USER=200
UPLOAD_RATE_LIMIT_PER_HOUR=30

# none (development) | clamav (clamd over TCP; see docker-compose.platform.yml)
MALWARE_SCANNER=none
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# auto: Tesseract if installed, otherwise Gemini vision (sends page images to Google)
OCR_PROVIDER=auto
# auto: Gemini when GEMINI_API_KEY is set, otherwise rules
DOCUMENT_AI_PROVIDER=auto

# inline: the API process runs background jobs (development)
# external: run `python -m app.worker` separately (production)
WORKER_MODE=inline
