# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- LLM (required) -----------------------------------------------------------
# Google Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Data -----------------------------------------------------------------------
SQLITE_DB_PATH=./customer_support_chat/data/travel2.sqlite
KNOWLEDGE_BASE_DIR=./knowledge_base

# --- Vector store (Qdrant) ------------------------------------------------------
# Embedded/local mode (default, no server needed). Only ONE process may open
# this folder at a time, so stop the API before running ingestion.
QDRANT_PATH=./customer_support_chat/data/qdrant_local
# Server mode: set QDRANT_URL (e.g. http://localhost:6333) to use a Qdrant
# server instead; it takes precedence over QDRANT_PATH.
QDRANT_URL=
QDRANT_API_KEY=

# --- RAG --------------------------------------------------------------------
RAG_TOP_K=4
RAG_CANDIDATES=12
RAG_RERANK=true
RAG_MIN_SCORE=0.2

# --- API / frontend -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
REQUEST_TIMEOUT_SECONDS=120
SESSION_TTL_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Development only: pre-fills the sign-in form. Leave empty in production.
DEMO_PASSENGER_ID=

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=text

# --- Optional infrastructure ------------------------------------------------------
# Hugging Face token (optional; only raises download rate limits for the
# embedding / reranker models).
HF_TOKEN=
# LangSmith tracing is OFF by default. It is only enabled when both of these
# are set; the app never fails because LangSmith is unavailable.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=customer-support-chat
